[Desktop Entry]
Version=1.0
Name=Studio to SVG
GenericName=Vector & Papercraft Studio
Comment=Studio to SVG — open and convert .studio, .studio3, .svg, and .craft files
Exec=studio-to-svg %F
Icon=studio-to-svg
Terminal=false
Type=Application
Categories=Graphics;VectorGraphics;2DGraphics;
MimeType=application/x-craft;application/x-studio;application/x-studio3;image/svg+xml;
StartupWMClass=studio-to-svg
Keywords=studio;svg;craft;papercraft;silhouette;vector;cut;cricut;cameo;
